# ─── Aegis bot — ortam değişkenleri ───────────────────────────────────────
# Bu dosyayı ".env" olarak kopyala ve değerleri doldur. .env ASLA commit edilmez.

# Discord
TOKEN=                      # Bot token (Discord Developer Portal)
CLIENT_ID=                  # Uygulama (bot) ID
CLIENT_SECRET=              # OAuth2 client secret (web paneli girişi için)
REDIRECT_URI=               # OAuth2 yönlendirme adresi, örn. https://site/api/auth/callback
AEGIS_OWNER_IDS=            # Bot sahiplerinin Discord ID'leri, virgülle ayrılır
ACTIVITY_APP_ID=            # (opsiyonel) Discord Activity uygulama ID

# Web paneli / sunucu
PORT=3005                   # Web API portu
STATS_PORT=                 # (opsiyonel) ayrı istatistik portu
SITE_URL=                   # Sitenin adresi, örn. https://betterwithaegis.com
PUBLIC_BASE_URL=            # Botun dışarıdan erişilen kök adresi
SUPPORT_SERVER_INVITE=      # Destek sunucusu davet linki
SESSION_SECRET=             # Oturum çerezi için rastgele uzun bir dize
ASSETS_DIR=                 # (opsiyonel) site assetlerinin klasörü; boşsa ./assets

# Yapay zekâ (opsiyonel; yoksa AI özellikleri hazır yanıtlara düşer)
GEMINI_API_KEY=             # Google Gemini API anahtarı (AutoMod ton analizi, sohbet, bilet AI)

# Güvenlik servisleri (opsiyonel)
GOOGLE_SAFEBROWSING_KEY=    # Google Safe Browsing (link taraması)
URLSCAN_API_KEY=            # urlscan.io (link kum havuzu)

# Bot listeleri (opsiyonel)
TOPGG_TOKEN=                # top.gg istatistik gönderimi

# Yedekleme (opsiyonel)
BACKUP_WEBHOOK_URL=         # Yedeklerin bildirileceği webhook
MAX_BACKUPS=10              # Sunucu başına saklanacak en fazla yedek
MIN_BOOT_INTERVAL_MINUTES=  # (opsiyonel) yeniden başlatma koruması

# Ödeme sağlayıcıları (opsiyonel; ücretli paketler için)
PAYMENT_PROVIDER=           # "paytr" | "iyzico" | boş
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=
ORDERS_LOG_CHANNEL_ID=      # Sipariş bildirimlerinin düşeceği kanal

NODE_ENV=production
